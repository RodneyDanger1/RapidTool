# Copy this file to `.env` and fill in your real keys. `.env` is never committed
# and is read only by server-side code (never inlined into the browser bundle).
# NEVER prefix any secret with VITE_.

# DeepSeek chat-completions key (https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-...

# Optional: real web-research backend (https://tavily.com). Leave blank to keep
# research in honest "not configured" deterministic-fallback mode.
TAVILY_API_KEY=tvly-...

# --- Advanced knobs (all optional — uncomment what you need) -----------------
# The browser app's dev/build tooling loads this file for you (npm run dev /
# build / preview route through scripts/with-app-env.mjs). The headless CLI
# does NOT read .env — export the variable in your own shell first
# (see scripts/README-cli.md §Live mode).

# Per-role model pins (registry.ts); a call-site model still wins over the pin:
# DEEPSEEK_MODEL_MAIN=<model-id>        # main tier (P6 synthesis, chat)
# DEEPSEEK_MODEL_REASONING=<model-id>   # reasoning passes
# DEEPSEEK_MODEL_WEAK=<model-id>        # cheap classification passes

# Per-RUN token cap (one ledger for the whole run; 0 or unset = uncapped):
# RAPIDTOOL_TOKEN_CAP=200000

# Human-seat approvals (HITL gates): the operator exports the seat token in
# their OWN shell — the machine side must NOT carry it (two-channel contract):
# RT_HUMAN_SEAT_TOKEN=<token>

# Audit-trail actor name (defaults to the OS user, else "cli-human"):
# RAPIDTOOL_ACTOR=<name>

# Pricing for the eval scorecard's cost reporting (USD per 1M tokens):
# RAPIDTOOL_PRICE_INPUT_PER_M=0.27
# RAPIDTOOL_PRICE_OUTPUT_PER_M=1.10

# NDJSON run-log directory override (default: <project>/.rapidtool/logs):
# RAPIDTOOL_LOG_DIR=<path>

# Eval harness (scripts/run-eval.mjs + the `eval` verb) scratch dirs; defaults
# under research/:
# EVAL_OUT_DIR=<path>      # eval-out dir the scorecard reads (results.json/history.json)
# EVAL_CORPUS_DIR=<path>   # corpus root
# EVAL_GRADER_DIR=<path>   # graders dir (default <corpus>/graders)

# Timeouts (ms) for the preview + browser smoke:
# PREVIEW_READY_TIMEOUT_MS=60000
# PREVIEW_THUMBNAIL_TIMEOUT_MS=45000
# BROWSER_SMOKE_TIMEOUT_MS=45000
# BROWSER_ALLOW_EXTERNAL_HOST=1   # opt out of the loopback-only browser guard

# --- Platform-injected (do NOT set by hand) ----------------------------------
# The deploy target / host platform provides these; this repo's npm scripts
# resolve VITE_AUTH_ENABLED from .grok/app-env.json (shipped "false"):
# GROK_GATE_ORIGIN, GROK_PROJECT_ID, GROK_CONNECTORS_URL, VITE_PUBLIC_HOSTNAME,
# VITE_AUTH_ENABLED, DATABASE_URL (empty/whitespace counts as unset).
