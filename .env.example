# Copy this file to `.env` and fill in your real keys. `.env` is never committed
# and is read only by server-side code (never inlined into the browser bundle).
# NEVER prefix any secret with VITE_.

# DeepSeek chat-completions key (https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-...

# Optional: real web-research backend (https://tavily.com). Leave blank to keep
# research in honest "not configured" deterministic-fallback mode.
TAVILY_API_KEY=tvly-...
